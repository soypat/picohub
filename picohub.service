# lives in /etc/systemd/system/picohub.service
[Unit]
   Description=picohub
   After=network.target

[Service]
   Type=simple
   # Runs as root: flashing mounts BOOTSEL volumes and opens serial ports,
   # both of which need privilege. Keep it simple until a real reason not to.
   WorkingDirectory=/home/pato/picohub
   # systemd sets no HOME for root services; `go` needs it to find GOPATH/module
   # cache (and writes its build cache under it).
   Environment=HOME=/root
   # Add flags normally after command.
   #
   # -openocd: systemd gives this service a minimal PATH, not a login shell's,
   # so an openocd built outside the system prefixes must be named explicitly.
   # Its configs are picked up from the scripts/ directory beside the binary.
   ExecStart=/usr/local/go/bin/go run /home/pato/picohub -openocd /home/pato/local/openocd/openocd
   Restart=always
   RestartSec=5

[Install]
   WantedBy=multi-user.target
